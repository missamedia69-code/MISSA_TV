<?xml version="1.0" encoding="utf-8"?>
<!--
  MISSA TV — manifeste applicatif

  Une seule activité porte les deux filtres d'intention : LAUNCHER (téléphone,
  tablette) et LEANBACK_LAUNCHER (Android TV). L'interface s'adapte ensuite au
  type d'appareil détecté à l'exécution (voir DeviceProfile).

  Aucune donnée de connexion (URL de portail, adresse MAC) n'est présente ici :
  la configuration est lue à distance ou saisie par l'utilisateur.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau : appels au portail et récupération de la configuration. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lecture en arrière-plan / Picture-in-Picture. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Aucune des deux plateformes n'est obligatoire : la même application
         s'installe sur TV, téléphone, tablette, Chromebook et boîtiers. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MissaTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MissaTv">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.MissaTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
